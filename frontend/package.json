{
  "name": "vocal-assessment-v7",
  "private": true,
  "version": "7.7.0",
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vue-tsc && vite build",
    "build:electron": "npm run build && tsc -p tsconfig.electron.json && electron-builder --config electron-builder.yml",
    "build:electron:dir": "npm run build && tsc -p tsconfig.electron.json && electron-builder --config electron-builder.yml --dir",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "gen:api": "openapi-typescript ../shared/openapi.json --output src/api/schema.d.ts",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron ."
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "chart.js": "^4.5.1",
    "element-plus": "^2.14.3",
    "gsap": "^3.15.0",
    "mitt": "^3.0.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.0.0",
    "happy-dom": "^13.10.1",
    "openapi-typescript": "^6.7.0",
    "sass": "^1.101.3",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^0.17.8",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.1",
    "vue-tsc": "^2.2.12"
  },
  "comments": {
    "phase5": "Electron desktop packaging complete. electron-builder.yml for NSIS config."
  }
}
